#!/bin/bash
set -e

echo "--- Building POCL for Vortex ---"

# Эти переменные будут подставлены из CMake
TOOLDIR="@VORTEX_TOOL_DIR@"
POCL_SRC_DIR="@SPLA_POCL_SOURCE_DIR@"
VORTEX_SRC_DIR="@VORTEX_SOURCE_DIR@"

cd "$POCL_SRC_DIR"
mkdir -p build && cd build

export POCL_PATH="$TOOLDIR/pocl"
export VORTEX_PREFIX="$VORTEX_SRC_DIR"
export LLVM_PREFIX="$TOOLDIR/llvm-vortex"

cmake -G "Unix Makefiles" -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=$POCL_PATH \
-DWITH_LLVM_CONFIG=$LLVM_PREFIX/bin/llvm-config -DVORTEX_PREFIX=$VORTEX_PREFIX -DENABLE_VORTEX=ON \
 -DKERNEL_CACHE_DEFAULT=OFF -DENABLE_HOST_CPU_DEVICES=OFF -DENABLE_TESTS=OFF -DPOCL_DEBUG_MESSAGES=ON -DENABLE_ICD=OFF ..

make -j`nproc`
make install
cp -r ../include "$POCL_PATH"

echo "--- POCL build finished ---"